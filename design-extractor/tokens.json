{
  "$source": "https://aptosnetwork.com",
  "$extractedAt": "2026-05-18",
  "color": {
    "raw": {
      "pure-white": "#fffffa",
      "white": "#f9f9f0",
      "cream": "#efecca",
      "sand": "#ccc5a3",
      "tan": "#9d937c",
      "ash": "#3d3b34",
      "graphite": "#2f2d28",
      "coal": "#21201c",
      "ink": "#171612",
      "black": "#0f0e0b",
      "mint": "#d5fad3",
      "blue": "#badbee",
      "coral": "#ff8866"
    },
    "brand": {
      "primary": "#0f0e0b",
      "primaryInverse": "#f9f9f0",
      "accentMint": "#d5fad3",
      "accentBlue": "#badbee",
      "accentCoral": "#ff8866",
      "accentBeige": {
        "light": "#ccc5a3",
        "dark": "#9d937c"
      }
    },
    "surface": {
      "100": { "light": "#f9f9f0", "dark": "#0f0e0b" },
      "200": { "light": "#efecca", "dark": "#171612" },
      "300": { "light": "#ccc5a3", "dark": "#21201c" },
      "400": { "light": "#9d937c", "dark": "#3d3b34" }
    },
    "text": {
      "primary":   { "light": "#0f0e0b", "dark": "#f9f9f0" },
      "secondary": { "light": "#171612", "dark": "#efecca" },
      "muted":     { "light": "#3d3b34", "dark": "#9d937c" },
      "inverse":   { "light": "#f9f9f0", "dark": "#0f0e0b" }
    },
    "border": {
      "default": { "light": "rgba(0,0,0,0.15)", "dark": "rgba(255,255,255,0.15)" },
      "subtle":  { "light": "rgba(0,0,0,0.08)", "dark": "rgba(255,255,255,0.08)" },
      "strong":  { "light": "rgba(0,0,0,0.30)", "dark": "rgba(255,255,255,0.30)" }
    },
    "state": {
      "success":      { "light": "#166534", "dark": "#68d391" },
      "error":        { "light": "#c53030", "dark": "#fc8181" },
      "warning":      { "light": "#a16207", "dark": "#eab308", "inferred": true },
      "successAccent":{ "light": "#dcfce7", "dark": "#22543d" },
      "errorAccent":  { "light": "#fef2f2", "dark": "#742a2a" },
      "warningAccent":{ "light": "#fef3c7", "dark": "#7c2d12" }
    }
  },
  "typography": {
    "fontFamily": {
      "base":    "\"Season Serif\", \"Times New Roman\", serif",
      "heading": "\"Season Serif\", \"Times New Roman\", serif",
      "mono":    "\"Akkurat Mono\", \"JetBrains Mono\", \"Courier New\", monospace",
      "$note": "Season Serif is a variable font with a SERF axis (0 = sans-like, 70 = serif). Switching the axis via animation is the signature hero effect."
    },
    "fontVariationAxis": {
      "name": "SERF",
      "sans": 0,
      "serif": 70
    },
    "fontSize": {
      "2xs": "0.563rem",
      "xs":  "0.688rem",
      "sm":  "0.813rem",
      "base":"1rem",
      "lg":  "1.125rem",
      "xl":  "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2.25rem",
      "4xl": "3.438rem",
      "5xl": "5.625rem",
      "6xl": "7.5rem"
    },
    "fontSizeMobile": {
      "2xl": "1.375rem",
      "3xl": "1.375rem",
      "4xl": "2rem",
      "5xl": "2.75rem",
      "6xl": "3.75rem"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "bold": 700,
      "variable": {
        "display":  335,
        "headline": 420,
        "subhead":  444,
        "body":     358,
        "caption":  400
      }
    },
    "lineHeight": {
      "tight":   "1.25",
      "normal":  "1.4",
      "relaxed": "1.625",
      "loose":   "2"
    },
    "letterSpacing": {
      "display":  "-0.03em",
      "headline": "-0.02em",
      "body":     "0.02em",
      "mono":     "0.03em"
    }
  },
  "spacing": {
    "$base": "5px",
    "$comment": "All spacing increments are multiples of 5px (Tailwind --spacing override).",
    "xs":  "5px",
    "sm":  "10px",
    "md":  "20px",
    "lg":  "40px",
    "xl":  "80px",
    "2xl": "120px",
    "3xl": "200px"
  },
  "container": {
    "xl":  "36rem",
    "2xl": "42rem",
    "4xl": "56rem",
    "5xl": "64rem",
    "big": "110rem"
  },
  "radius": {
    "sm":   "4px",
    "md":   "6px",
    "lg":   "12px",
    "xl":   "24px",
    "pill": "9999px"
  },
  "shadow": {
    "$note": "Aptos uses an almost-flat aesthetic; shadows are minimal. Floating nav pill uses a faint warm shadow.",
    "sm":  "0 1px 2px rgba(15,14,11,0.06)",
    "md":  "0 4px 12px rgba(15,14,11,0.08)",
    "lg":  "0 12px 32px rgba(15,14,11,0.12)",
    "xl":  "0 24px 60px rgba(15,14,11,0.16)"
  },
  "motion": {
    "duration": {
      "fast":   "0.15s",
      "normal": "0.3s",
      "slow":   "1s",
      "epic":   "2s"
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "enter":    "cubic-bezier(0, 0, 0.2, 1)",
      "exit":     "cubic-bezier(0.4, 0, 1, 1)",
      "textMask": "cubic-bezier(0.76, 0, 0.24, 1)"
    },
    "keyframes": [
      "parallax-in",
      "parallax-out",
      "fade",
      "text-mask-in",
      "text-mask-in-light",
      "text-mask-out",
      "text-mask-out-light",
      "appear-mask-in-from-right",
      "stackable-shrink",
      "marquee-ltr",
      "marquee-rtl",
      "marquee-scroll"
    ],
    "source": "pure-css",
    "scrollDriven": true
  },
  "opacity": {
    "disabled": 0.4,
    "hover":    0.8,
    "muted":    0.6,
    "overlay":  0.15
  },
  "breakpoints": {
    "sm":  "40rem",
    "md":  "48rem",
    "lg":  "64rem",
    "xl":  "80rem",
    "2xl": "96rem",
    "big": "110rem"
  }
}
