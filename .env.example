# Production canonical site URL. Must be set in Vercel for ALL environments
# (Production + Preview + Development) and locally in .env.local. Used for
# canonical / hreflang / og:url / sitemap / robots / Schema.org JSON-LD.
# DO NOT rely on VERCEL_URL — that resolves to the per-deploy preview host.
NEXT_PUBLIC_SITE_URL=https://www.help-me-invest.com

# FMP (Financial Modeling Prep) API
FMP_API_KEY=your_fmp_api_key_here

# Google Gemini API (model: gemini-3.1-flash-lite) — 主报告 / 解释 / 翻译 / 资产配置
GOOGLE_API_KEY=your_google_api_key_here

# Optional: protects legacy high-cost AI endpoints. Leave unset unless you call
# /api/analyze or /api/ai/* directly from trusted automation with this bearer key.
AI_INTERNAL_API_KEY=generate_a_long_random_value_here

# DeepSeek API — 仅供主页股票联想 (/api/symbol-suggest) 使用，
# 在高频低复杂度场景下比 Gemini 3.5 Flash 响应更快
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Supabase 配置
# 从 Supabase 项目设置 -> API 中获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ====================================
# Supabase 数据库表设置说明
# ====================================
# 请在 Supabase SQL Editor 中执行以下 SQL 来创建表：
#
# -- 创建搜索记录表
# CREATE TABLE search_records (
#   id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
#   symbol VARCHAR(20) NOT NULL,
#   company_name VARCHAR(255),
#   search_count INTEGER DEFAULT 1,
#   is_valid BOOLEAN DEFAULT true,
#   last_searched_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
#   created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
# );
#
# -- 创建索引以优化查询性能
# CREATE INDEX idx_search_records_symbol ON search_records(symbol);
# CREATE INDEX idx_search_records_valid ON search_records(is_valid);
# CREATE INDEX idx_search_records_count ON search_records(search_count DESC);
# CREATE INDEX idx_search_records_last_searched ON search_records(last_searched_at DESC);
