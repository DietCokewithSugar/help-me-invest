# Production canonical site URL. Must be set for ALL environments
# (在 Vercel 上是 Production + Preview + Development；在 Render 等自建平台上是服务的环境变量)
# 以及本地的 .env.local。Used for
# canonical / hreflang / og:url / sitemap / robots / Schema.org JSON-LD.
# DO NOT rely on VERCEL_URL — that resolves to the per-deploy preview host.
NEXT_PUBLIC_SITE_URL=https://www.help-me-invest.com

# FMP (Financial Modeling Prep) API
FMP_API_KEY=your_fmp_api_key_here

# ====================================
# DeepSeek API — 主报告 / 解释 / 翻译 / 资产配置 / 股票联想
# ====================================
# 旧模型名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线，
# 现仅 deepseek-v4-flash / deepseek-v4-pro 可用。
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 以下均可留空，留空即用括号内的默认值。
# 接口地址（默认 https://api.deepseek.com）。指向自建网关或代理时改这里即可；
# 写成 .../v1 或 .../chat/completions 都能正确识别。
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 主模型（默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash
# 专业版报告所用模型（默认与 DEEPSEEK_MODEL 相同）。想让深度报告走 pro 时改这里。
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# 思考模式总开关（默认 auto）。
# deepseek-v4-flash 默认开启思考模式，且推理与回答共享 max_tokens 预算，
# 因此代码里每个调用点都显式声明了开或关：判断类报告段落开，短任务与 JSON 抽取关。
# auto = 按代码内策略；off = 全部关闭（最快最省）；on = 全部开启（慢且贵，仅用于对比实验）
# DEEPSEEK_THINKING_OVERRIDE=auto
# 开启思考时的推理强度，接口仅接受 high / max（默认 high）
# DEEPSEEK_REASONING_EFFORT=high

# 进程内并发限流（默认 2 / 500ms）。注意这是「每进程」的：
# Vercel 上每个实例各有一份，起不到全局作用；自建服务器上是单进程，才真正全局生效，
# 届时可适当放宽。
# DEEPSEEK_MAX_CONCURRENT=2
# DEEPSEEK_MIN_DELAY_MS=500

# 设为 1 时在服务端日志打印 reasoning_content 长度与 usage，用于确认思考模式是否符合预期
# DEEPSEEK_DEBUG=0

# 注意：不设置此变量时 /api/analyze 与 /api/ai/* 一律返回 404（不是 401），
# 即这些端点默认是**关闭**的。只有需要用该 bearer key 从可信自动化直接调用时才设置。
AI_INTERNAL_API_KEY=generate_a_long_random_value_here

# Supabase 配置
# 从 Supabase 项目设置 -> API 中获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ====================================
# Supabase 数据库表设置说明
# ====================================
# 请在 Supabase SQL Editor 中执行以下 SQL 来创建表：
#
# -- 创建搜索记录表
# CREATE TABLE search_records (
#   id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
#   symbol VARCHAR(20) NOT NULL,
#   company_name VARCHAR(255),
#   search_count INTEGER DEFAULT 1,
#   is_valid BOOLEAN DEFAULT true,
#   last_searched_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
#   created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
# );
#
# -- 创建索引以优化查询性能
# CREATE INDEX idx_search_records_symbol ON search_records(symbol);
# CREATE INDEX idx_search_records_valid ON search_records(is_valid);
# CREATE INDEX idx_search_records_count ON search_records(search_count DESC);
# CREATE INDEX idx_search_records_last_searched ON search_records(last_searched_at DESC);
